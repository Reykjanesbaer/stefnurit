{
  "name": "stefnu-rit",
  "version": "1.0.0",
  "description": "Reykjanesbær Stefnurit — an embeddable, data-driven policy map web component",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/stefnu-rit.js",
  "module": "./dist/stefnu-rit.js",
  "exports": {
    ".": "./dist/stefnu-rit.js",
    "./data": "./src/data/stefnurit.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:widget && npm run build:admin",
    "build:widget": "vite build",
    "build:admin": "vite build --config admin/vite.config.js",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check-links": "node scripts/check-links.mjs",
    "check-changed-links": "node scripts/check-changed-links.mjs",
    "validate:data": "node scripts/validate-document.mjs",
    "format:data": "node scripts/format-document.mjs",
    "assemble": "node scripts/assemble-pages.mjs",
    "qa": "node scripts/visual-qa.mjs",
    "qa:diff": "node scripts/qa-diff.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.17.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
